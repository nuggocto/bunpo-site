---
import { Code } from "astro:components";
import { getCollection } from "astro:content";
import HiveSplitDemo from "../components/HiveSplitDemo.astro";
import InstallLine from "../components/InstallLine.astro";
import SplitResult from "../components/SplitResult.astro";
import Terminal from "../components/Terminal.astro";
import { formatSeconds, type MachineBar, trials } from "../data/benchmarks";
import Base from "../layouts/Base.astro";

const guides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);

const trial = trials.find((t) => t.id === "majlisna-backend");
if (!trial) throw new Error("majlisna-backend trial is missing");
const times = (bars: MachineBar[]) => bars.map((b) => b.seconds);
const slowest = (bars: MachineBar[]) => Math.max(...times(bars));
const spread = (bars: MachineBar[]) => (slowest(bars) - Math.min(...times(bars))).toFixed(1);
const files = trial.afterBars.reduce((sum, b) => sum + b.files, 0);

const workflow = `# on each of 4 machines
- uses: nuggocto/bunpo@v0
- run: |
    find tests -name 'test_*.py' |
      bunpo split --index "$INDEX" --total "$TOTAL" > mine.txt
    # run the files in mine.txt and write junit.xml
    bunpo record --index "$INDEX" junit.xml

# in one final job
- run: |
    find tests -name 'test_*.py' | bunpo verify
    bunpo merge`;

const alternatives = [
	{
		name: "jest --shard\nvitest --shard",
		split: "Equal file counts, ordered by a hash of each path. No timings.",
		pick: "Your files take about the same time.",
	},
	{
		name: "playwright --shard",
		split: "Test counts. Splits inside files with fullyParallel. No timings.",
		pick: "Your tests take about the same time.",
	},
	{
		name: "pytest-split",
		split: "Recorded time of each test, from a file kept in your repo.",
		pick: "You only use pytest, or one file is too slow to stay whole.",
	},
	{
		name: "Knapsack Pro",
		split: "Recorded times through its API. Machines pull files from a queue.",
		pick: "Your machines differ in speed or start late, and a paid service is fine (free for non-commercial open source).",
	},
	{
		name: "Bunpō",
		split: "Recorded time of each file, from your CI cache. Checks the assignment.",
		pick: "You want one free tool for several runners, with no server.",
		self: true,
	},
];
---

<Base title="Bunpō (分蜂) — Split CI tests by recorded time, verify every file once">
	<section class="hero">
		<div>
			<span class="eyebrow">分蜂 · the bees dividing their hive</span>
			<h1>Split your tests so CI machines finish together.</h1>
			<p class="lead">
				Bunpō balances test files by recorded time, and fails the build if a file is assigned
				twice or not at all. It is one static binary with no server.
			</p>
			<InstallLine />
			<div class="actions">
				<a href="/guides" class="btn">Set up your runner</a>
				<a href="/install" class="btn btn-ghost">Other installs</a>
			</div>
		</div>
		<figure class="hero-art">
			<picture>
				<source srcset="/brand/mitsu.webp" type="image/webp" />
				<img
					src="/brand/mitsu.png"
					alt="Mitsu, a round honey-brown and cream bee with pale mint wings and a honeycomb satchel, holding out a hexagonal cell in watercolor and ink"
					width="264"
					height="264"
				/>
			</picture>
			<figcaption class="hero-caption">Mitsu · cells of equal weight</figcaption>
		</figure>
	</section>

	<div class="gains">
		<div class="gain">
			<p class="gain-title">Half the wait</p>
			<p class="gain-data">
				{formatSeconds(slowest(trial.beforeBars))} → {formatSeconds(slowest(trial.afterBars))}
			</p>
			<p class="gain-note">until the slowest machine finishes</p>
		</div>
		<div class="gain">
			<p class="gain-title">7s apart, not 3 min</p>
			<p class="gain-data">{spread(trial.beforeBars)}s → {spread(trial.afterBars)}s</p>
			<p class="gain-note">between the first and last machine to finish</p>
		</div>
		<p class="gain-scope">
			Best of 7 suites tried: {files} pytest files on the same {trial.afterBars.length} machines, vs.
			splitting by count. <a href="/benchmarks">See&nbsp;all&nbsp;seven</a>
		</p>
	</div>

	<ul class="facts" aria-label="Key facts">
		<li>5 tested guides</li>
		<li>3.2 MiB binary</li>
		<li>no server, timings in your CI cache</li>
	</ul>

	<section class="band" id="how-it-works">
		<div class="band-head">
			<div class="band-label">
				<strong>How it works</strong>
				<span>Longest file first</span>
			</div>
			<div>
				<h2>Deal the slowest files first, then check the deal.</h2>
				<p>
					Six files across two machines. By name, machine 0 gets the three slowest files. Bunpō
					gives each file, longest first, to the machine with the smallest load. If one
					machine restores old timings, <code>bunpo verify</code> catches the mismatch.
				</p>
				<HiveSplitDemo />
			</div>
		</div>
	</section>

	<section class="band" id="benchmarks">
		<div class="band-head">
			<div class="band-label">
				<strong>Result</strong>
				<span>Measured on a production suite</span>
			</div>
			<div>
				<h2>Half the time of a count split, on the same four machines.</h2>
				<p>
					A build waits for its slowest machine. Counting files put one slow WebSocket file on
					a machine with 27 others. Bunpō gave that file its own machine.
				</p>
				<SplitResult />
				<p class="small">
					Suites with evenly sized files gain less, and some gain nothing.{" "}
					<a href="/benchmarks">See every suite&nbsp;→</a>
				</p>
			</div>
		</div>
	</section>

	<section class="band" id="workflow">
		<div class="band-head">
			<div class="band-label">
				<strong>In your pipeline</strong>
				<span>Four commands</span>
			</div>
			<div>
				<h2>Your runner still runs the tests.</h2>
				<div class="code-frame">
					<div class="code-bar">
						<span>Outline · the guides have the full workflow</span>
					</div>
					<Code code={workflow} lang="yaml" theme="github-light" />
				</div>
				<ol class="steps-list">
					<li>
						<span class="step-cmd">split</span>
						<div>
							prints this machine's files and writes a manifest with a digest of the list and
							timings it used.
						</div>
					</li>
					<li>
						<span class="step-cmd">record</span>
						<div>
							reads your JUnit report and keeps each file's time. A failed file never records a
							bad time.
						</div>
					</li>
					<li>
						<span class="step-cmd">verify</span>
						<div>
							fails unless every machine split the same input and each file was assigned exactly
							once.
						</div>
					</li>
					<li>
						<span class="step-cmd">merge</span>
						<div>
							updates <code>timings.json</code> with each file's last five times. Splits use their
							median.
						</div>
					</li>
				</ol>
				<p class="small muted steps-note">
					<code>verify</code> checks assignments, not execution. Your workflow still checks that
					each runner passed, and every guide does both.
				</p>
			</div>
		</div>
	</section>

	<section class="band" id="demo">
		<div class="band-head">
			<div class="band-label">
				<strong>In the terminal</strong>
				<span>Output from v0.0.6</span>
			</div>
			<div>
				<h2>What it prints, and how it fails.</h2>
				<p>
					File lists go to standard output and messages to standard error. Exit status is{" "}
					<code>0</code> on success, <code>1</code> when a check fails, and <code>2</code> on bad
					input or flags. The 12 files and their times are made up; the output is not.
				</p>
				<Terminal />
			</div>
		</div>
	</section>

	<section class="band" id="compare">
		<div class="band-head">
			<div class="band-label">
				<strong>Alternatives</strong>
				<span>When to skip it</span>
			</div>
			<div>
				<h2>You may not need Bunpō.</h2>
				<div class="table-wrap">
					<table class="compare">
						<thead>
							<tr>
								<th>Tool</th>
								<th>Splits by</th>
								<th>Pick it when</th>
							</tr>
						</thead>
						<tbody>
							{
								alternatives.map((a) => (
									<tr class:list={{ "compare-self": a.self }}>
										<th scope="row">{a.name}</th>
										<td data-label="Splits by">{a.split}</td>
										<td data-label="Pick it when">{a.pick}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<p class="small muted">
					Bunpō splits whole files, so one file slower than the average machine load sets the
					floor. It warns you when that happens.
				</p>
			</div>
		</div>
	</section>

	<section class="band" id="guides">
		<div class="band-head">
			<div class="band-label">
				<strong>Guides</strong>
				<span>Tested on real runners</span>
			</div>
			<div>
				<h2>Pick your runner.</h2>
				<p>Each guide is a complete GitHub Actions workflow you can copy.</p>
				<ul class="runner-list">
					{
						guides.map((g) => (
							<li>
								<a href={`/guides/${g.id}`} class="runner-row">
									<span class="runner-name">{g.data.title}</span>
									<span class="runner-detail">
										{g.data.reportFormat} · {g.data.selection}
									</span>
									<span class="runner-arrow">guide →</span>
								</a>
							</li>
						))
					}
				</ul>
				<p class="other-ci">
					<strong>Not on GitHub Actions?</strong> The binary does not depend on it, so it also runs
					on GitLab CI, Buildkite, Woodpecker CI, and Forgejo or Gitea Actions. Those do not have
					a copy-paste workflow yet. <a href="/guides#other-ci">What to wire up →</a>
				</p>
			</div>
		</div>
	</section>
</Base>
