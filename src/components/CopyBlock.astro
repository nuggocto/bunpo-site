---
interface Props {
	label: string;
	code: string;
}

const { label, code } = Astro.props;
---

<div class="code-frame">
	<div class="code-bar">
		<span>{label}</span>
		<button type="button" class="copy-btn" data-copy={code} aria-label={`Copy: ${label}`}>copy</button>
	</div>
	<pre><code>{code}</code></pre>
</div>

<script>
	import "../scripts/copy";
</script>
