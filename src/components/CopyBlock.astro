---
interface Props {
	label: string;
	code: string;
	/** Let a short command wrap on narrow screens instead of scrolling sideways. */
	wrap?: boolean;
}

const { label, code, wrap = false } = Astro.props;
---

<div class="code-frame">
	<div class="code-bar">
		<span>{label}</span>
		<button type="button" class="copy-btn" data-copy={code} aria-label={`Copy: ${label}`}>copy</button>
	</div>
	{/* Cloudflare's email obfuscation reads "bunpo@v0.1.2" as an address and
	    rewrites it in the HTML; commands are never addresses. */}
	<Fragment set:html={"<!--email_off-->"} />
	<pre class:list={{ "code-wrap": wrap }}><code>{code}</code></pre>
	<Fragment set:html={"<!--/email_off-->"} />
</div>

<script>
	import "../scripts/copy";
</script>
