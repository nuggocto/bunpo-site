---
import { workedExample } from "../data/benchmarks";

interface CombFile {
	name: string;
	minutes: number;
	duplicate?: boolean;
}

interface CombMachine {
	machine: number;
	files: CombFile[];
	total: number;
	stale?: boolean;
}

interface DemoState {
	id: string;
	label: string;
	sub: string;
	machines: CombMachine[];
	/* PROJECT.md: a cell glows only when verify has passed. */
	glow: boolean;
	unassigned: string;
	resultState: "plain" | "verified" | "error";
	status: string;
	output: string;
}

/* Split and verify output below is copied from bunpo v0.1.2 runs of this six-file example. */
const states: DemoState[] = [
	{
		id: "byname",
		label: "By name",
		sub: "22m / 12m",
		machines: workedExample.byName,
		glow: false,
		unassigned: "nothing checks",
		resultState: "plain",
		status: "by name:",
		output:
			"alphabetical order puts auth, billing, and checkout on machine 0. Machine 1 finishes in 12 minutes and waits 10 more.",
	},
	{
		id: "split",
		label: "bunpo split",
		sub: "17m / 17m",
		machines: workedExample.byTiming,
		glow: false,
		unassigned: "not checked yet",
		resultState: "plain",
		status: "bunpo:",
		output:
			"predicted machine loads from 17m0s to 17m0s, average 17m0s; longest file tests/test_auth.py at 9m0s\nbunpo: machine 0 of 2 gets 3 of 6 tests, predicted 17m0s",
	},
	{
		id: "verified",
		label: "bunpo verify",
		sub: "passed",
		machines: workedExample.byTiming,
		glow: true,
		unassigned: "none",
		resultState: "verified",
		status: "bunpo: assignment verified:",
		output:
			"6 tests across 2 machines, each assigned exactly once, all split from the same input and timings (digest 1d81686a7841…)\nbunpo: this checks what each machine was asked to run, not what ran; check each runner's result and report separately",
	},
	{
		id: "stale",
		label: "Stale cache",
		sub: "caught",
		machines: workedExample.staleCache,
		glow: false,
		unassigned: "checkout 6m, would never run",
		resultState: "error",
		status: "bunpo verify: error:",
		output:
			"assignment check failed:\n  - machines split different inputs or used different timings: 1d81686a7841… on machine 0; dfc79e6d2958… on machine 1\n  - 1 test assigned to more than one machine: tests/test_auth.py (machines 0, 1)\n  - 1 test in the input but assigned to no machine: tests/test_checkout.py",
	},
];

/* Every state shares one scale: one column per minute of the slowest by-name machine. */
const scale = Math.max(...workedExample.byName.map((m) => m.total));
const CELL = 20;
const cellPoints = (i: number) => {
	const x = i * CELL;
	return `${x + 10},1 ${x + 19},6 ${x + 19},17 ${x + 10},22 ${x + 1},17 ${x + 1},6`;
};
const shortName = (name: string) => name.replace("tests/test_", "").replace(".py", "");
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
---

<div class="hive-box" data-tabs>
	<div class="tabs tabs-4" role="tablist" aria-label="Split and verify walkthrough">
		{
			states.map((s, idx) => (
				<button
					type="button"
					class="tab-btn"
					role="tab"
					aria-selected={idx === 0 ? "true" : "false"}
					tabindex={idx === 0 ? 0 : -1}
					aria-controls={`hive-panel-${s.id}`}
					id={`hive-tab-${s.id}`}
				>
					<span>{s.label}</span>
					<span class="tab-sub">{s.sub}</span>
				</button>
			))
		}
	</div>

	<p class="comb-key">One cell is one minute. Dashed cells are a machine waiting.</p>

	<div class="tab-stack">
		{
			states.map((s, idx) => {
				const slowest = Math.max(...s.machines.map((m) => m.total));
				return (
					<div
						id={`hive-panel-${s.id}`}
						role="tabpanel"
						aria-labelledby={`hive-tab-${s.id}`}
						hidden={idx !== 0}
					>
						{s.machines.map((m) => {
							const idle = slowest - m.total;
							return (
								<div class="comb-row">
									<div class="comb-head">
										<span>
											machine {m.machine}
											{m.stale ? " (stale cache)" : ""}
										</span>
										<span>
											{idle > 0 && <span class="muted">waits {idle}m </span>}
											<strong>{m.total}m</strong>
										</span>
									</div>
									<div class="comb-track" style={`--comb-scale: ${scale}`}>
										{m.files.map((f) => {
											const stroke = f.duplicate ? "#B42D3F" : s.glow ? "#1F7A5A" : "#2B1F16";
											return (
												<div class="comb-file" style={`--span: ${f.minutes}`}>
													<svg viewBox={`0 0 ${f.minutes * CELL} 23`} aria-hidden="true">
														{range(f.minutes).map((i) => (
															<>
																{s.glow && (
																	<polygon
																		points={cellPoints(i)}
																		fill="none"
																		stroke="#43A581"
																		stroke-opacity="0.35"
																		stroke-width="3.5"
																		stroke-linejoin="round"
																	/>
																)}
																<polygon
																	points={cellPoints(i)}
																	fill={s.glow ? "#F6ECD9" : "#FFFFFF"}
																	stroke={stroke}
																	stroke-width={f.duplicate ? "1.6" : "1"}
																	stroke-linejoin="round"
																/>
															</>
														))}
													</svg>
													<span class:list={["comb-label", { "comb-label-bad": f.duplicate }]}>
														<span class="comb-name">{shortName(f.name)} </span>
														{f.minutes}m
													</span>
												</div>
											);
										})}
										{idle > 0 && (
											<div class="comb-file" style={`--span: ${idle}`}>
												<svg viewBox={`0 0 ${idle * CELL} 23`} aria-hidden="true">
													{range(idle).map((i) => (
														<polygon
															points={cellPoints(i)}
															fill="none"
															stroke="#B9AD9C"
															stroke-width="1"
															stroke-dasharray="2 2.5"
														/>
													))}
												</svg>
											</div>
										)}
									</div>
									<p class="comb-legend" aria-hidden="true">
										{m.files.map((f) => `${shortName(f.name)}\u00a0${f.minutes}m`).join(" · ")}
									</p>
								</div>
							);
						})}

						<div class="comb-row">
							<div class="comb-head">
								<span>assigned to no machine</span>
								<span class={s.resultState === "error" ? "comb-label-bad" : "muted"}>{s.unassigned}</span>
							</div>
						</div>

						<div class="plain-result" data-state={s.resultState}><span class="status-tag">{s.status}</span>{` ${s.output}`}</div>
					</div>
				);
			})
		}
	</div>
</div>

<script>
	import "../scripts/tabs";
</script>
