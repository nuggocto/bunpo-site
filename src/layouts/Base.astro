---
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-ext-400.css";
import "@fontsource/ibm-plex-mono/latin-ext-500.css";
import "@fontsource/ibm-plex-mono/latin-ext-600.css";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-sans/latin-ext-400.css";
import "@fontsource/ibm-plex-sans/latin-ext-500.css";
import "@fontsource/ibm-plex-sans/latin-ext-600.css";
import "@fontsource/newsreader/latin-400.css";
import "@fontsource/newsreader/latin-500.css";
import "@fontsource/newsreader/latin-600.css";
import "@fontsource/newsreader/latin-ext-400.css";
import "@fontsource/newsreader/latin-ext-500.css";
import "@fontsource/newsreader/latin-ext-600.css";
import "../styles/global.css";
import { LATEST_VERSION } from "../data/releases";
import { asset } from "../lib/asset";

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
}

const {
	title,
	description = "Split test suites across parallel CI machines by recorded timings, and verify that every test file was assigned once.",
	noindex = false,
} = Astro.props;

interface NavItem {
	href: string;
	label: string;
	external?: boolean;
}

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(asset("/brand/og.png"), Astro.site).href;
const internalNav: NavItem[] = [
	{ href: "/install", label: "install" },
	{ href: "/guides", label: "guides" },
	{ href: "/benchmarks", label: "benchmarks" },
	{ href: "/changelog", label: "changelog" },
];
const githubUrl = "https://github.com/nuggocto/bunpo";
const mobileNav: NavItem[] = [...internalNav, { href: githubUrl, label: "github", external: true }];

const isCurrent = (href: string, external?: boolean) =>
	!external && (path === href || path.startsWith(`${href}/`));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta name="theme-color" content="#faf8f5" />
		<link rel="icon" type="image/png" sizes="64x64" href={asset("/favicon.png")} />
		<link rel="apple-touch-icon" sizes="180x180" href={asset("/brand/logo-mark.png")} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Bunpō" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Mitsu the bee beside the words: Split your tests so CI machines finish together." />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<header class="site-header">
			<div class="header-wrap header-inner">
				<a href="/" class="brand-link" aria-label="Bunpō home">
					<picture>
						<source srcset={asset("/brand/logo-mark.webp")} type="image/webp" />
						<img src={asset("/brand/logo-mark.png")} alt="" class="brand-mark" width="38" height="38" />
					</picture>
					<span class="brand-name">Bunpō</span>
					<span class="brand-ver">{LATEST_VERSION}</span>
				</a>

				<nav class="site-nav" aria-label="Primary">
					{
						internalNav.map((item) => (
							<a
								href={item.href}
								aria-current={isCurrent(item.href) ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<div class="header-actions">
					<a
						href={githubUrl}
						class="nav-github"
						target="_blank"
						rel="noreferrer"
					>
						<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
						</svg>
						<span>GitHub</span>
					</a>

					<details class="nav-mobile" data-mobile-nav>
						<summary class="nav-toggle" aria-label="Open menu">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
								<path d="M4 7h16M4 12h16M4 17h16"></path>
							</svg>
						</summary>
						<nav class="nav-drawer" aria-label="Mobile navigation">
							{
								mobileNav.map((item) => (
									<a
										href={item.href}
										aria-current={isCurrent(item.href, item.external) ? "page" : undefined}
										target={item.external ? "_blank" : undefined}
										rel={item.external ? "noreferrer" : undefined}
									>
										{item.label}
									</a>
								))
							}
						</nav>
					</details>
				</div>
			</div>
		</header>

		<main>
			<div class="wrap">
				<slot />
			</div>
		</main>

		<footer class="site-footer">
			<div class="wrap footer-inner">
				<div class="footer-brand">
					<img src={asset("/brand/logo-mono.svg")} alt="" width="24" height="24" />
					<span class="mono">bunpo {LATEST_VERSION} · Apache-2.0 · no server, no telemetry</span>
				</div>
				<div class="footer-links">
					<a href="/install">install</a>
					<a href="/guides">guides</a>
					<a href="/benchmarks">benchmarks</a>
					<a href="/changelog">changelog</a>
					<a href="https://github.com/nuggocto/bunpo/releases" target="_blank" rel="noreferrer">releases</a>
					<a href="https://github.com/nuggocto/bunpo" target="_blank" rel="noreferrer">source</a>
				</div>
			</div>
		</footer>

		<script>
			const mobileNav = document.querySelector<HTMLDetailsElement>("[data-mobile-nav]");
			if (mobileNav) {
				document.addEventListener("click", (e) => {
					if (mobileNav.open && e.target instanceof Node && !mobileNav.contains(e.target)) {
						mobileNav.open = false;
					}
				});
				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && mobileNav.open) {
						mobileNav.open = false;
					}
				});
			}
		</script>
	</body>
</html>
